# ── DATABASE (Neon PostgreSQL) ──────────────────────────────────────────────
# Lấy từ Neon Console → Connection String → chọn "psycopg2" hoặc "SQLAlchemy"
# Neon yêu cầu SSL → thêm ?sslmode=require ở cuối
DATABASE_URL=postgresql+psycopg2://user:password@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require

# ── CORS (Vercel frontend URLs) ──────────────────────────────────────────────
# Điền URL Vercel sau khi deploy (cách nhau bởi dấu phẩy nếu có nhiều)
# VD: https://website-oto.vercel.app,https://www.atelier-auto.vn
CORS_ORIGINS=https://your-app.vercel.app

# ── Storage Provider ─────────────────────────────────────────────────────────
STORAGE_PROVIDER=cloudinary

# ── Cloudinary (giữ nguyên từ .env local) ────────────────────────────────────
CLOUDINARY_CLOUD_NAME=tvbodbqn
CLOUDINARY_API_KEY=956139649412987
CLOUDINARY_API_SECRET=X92FLS6PZeql77H-f3WgdlyOfvM

# ── AWS S3 (để sau nếu cần) ───────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
AWS_BUCKET_NAME=website-oto-assets
